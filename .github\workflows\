name: Gerar APK

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Instalar dependências
        run: npm install

      - name: Criar projeto Android
        run: npx cap add android

      - name: Instalar captura de notificações, ícone e permissões
        run: |
          cp -r resources/android/res/* android/app/src/main/res/
          mkdir -p android/app/src/main/java/app/financeiro/pessoal
          cp resources/android/java/*.java android/app/src/main/java/app/financeiro/pessoal/
          python3 resources/android/patch_manifest.py

      - name: Copiar o app para o Android
        run: npx cap sync android

      - name: Compilar APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Guardar o APK
        uses: actions/upload-artifact@v4
        with:
          name: Financeiro-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
